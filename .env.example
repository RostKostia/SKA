# Kerdos: example settings. Copy this file to .env and fill in your own values.
# Never commit the real .env file: it holds secrets.

# ---------- Bank of Cyprus sandbox (PSD2: accounts and payments) ----------
# From sandbox.bankofcyprus.com, after you create an app under My Apps.
BOC_CLIENT_ID=
# Shown only once when the app is created. Keep it secret.
BOC_CLIENT_SECRET=
# Must match the app's OAuth redirect URI exactly, character for character.
# The backend's callback: register this same value on the BoC portal.
BOC_REDIRECT_URI=http://localhost:8080/api/bank/callback
# Sandbox PSD2 base URL (paths use /v1 under it).
BOC_BASE_URL=https://sandbox-apis.bankofcyprus.com/df-boc-org-sb/sb/psd2
# Sandbox-only helper that signs payment payloads (stands in for a QSeal certificate).
BOC_SIGN_URL=https://sandbox-apis.bankofcyprus.com/df-boc-org-sb/sb/jwssignverifyapi/sign
# tppId header sent to the signing helper.
BOC_TPP_ID=singpaymentdata
# Test customer for the browser consent screen (public sandbox values, not real accounts).
BOC_SANDBOX_USERNAME=999999
BOC_SANDBOX_PASSCODE=112233
# Sandbox test account used in examples.
BOC_ACCOUNT_ID=351012345671

# ---------- Jinius (BoC B2B: e-invoicing, payments) ----------
# Account API key for the Jinius Marketplace API. Confirm access with the organisers.
JINIUS_API_KEY=

# ---------- Claude (natural-language invoice parsing) ----------
# From console.anthropic.com.
ANTHROPIC_API_KEY=

# ---------- Kerdos backend (Go, backend/) ----------
# Use the password from db/.env.
KERDOS_DATABASE_URL=postgres://kerdos:<KERDOS_DB_PASSWORD>@127.0.0.1:5432/kerdos?sslmode=disable
KERDOS_HTTP_ADDR=:8080
# The frontend: pay links point to <this>/pay/<token>.
KERDOS_PUBLIC_URL=http://localhost:3000
# 1 enables Skip time and Reset (/api/demo/*). Set 0 outside the demo.
KERDOS_DEMO=1
# mock uses the sample account; boc uses the BoC sandbox with the BOC_* settings above.
KERDOS_BANK=mock
# Model for chat parsing when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Email (optional) ----------
# Without SMTP_HOST, emails are only logged. Gmail: smtp.gmail.com, port 587, an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
